---
import Base from '../layouts/Base.astro';
import Cruz from '../components/Cruz.astro';
import Trama from '../components/Trama.astro';
import Marco from '../components/Marco.astro';
import Hilvan from '../components/Hilvan.astro';
import Pasos from '../components/Pasos.astro';
import Faq from '../components/Faq.astro';
import CtaFinal from '../components/CtaFinal.astro';

import site from '../data/site.json';
import data from '../data/inicio.json';
import pasos from '../data/pasos.json';
import equipo from '../data/equipo.json';
import faq from '../data/faq.json';

const dos = (n: number) => String(n + 1).padStart(2, '0');
const wa = `https://wa.me/${site.whatsapp}`;
---
<Base titulo={data.seo.titulo} descripcion={data.seo.descripcion}>

  <!-- HERO -->
  <section class="hero section">
    <div class="hero-texto">
      <div class="eyebrow eyebrow-sm hero-eyebrow"><Cruz /><span>{data.hero.eyebrow}</span></div>
      <h1 class="h1">{data.hero.titulo}</h1>
      <p class="hero-p">{data.hero.texto}</p>
      <div class="botones">
        <a href="/contacto#agenda" class="btn btn-primary">{site.botonAgenda}</a>
        <a href={wa} class="btn btn-outline" target="_blank" rel="noopener">{site.botonWhatsapp}</a>
      </div>
      <div class="eyebrow eyebrow-sm tagline">{site.tagline}</div>
    </div>
    <Marco imagen={data.hero.imagen} alt={data.hero.titulo} etiqueta={data.hero.imagenEtiqueta} ratio="4/5" />
  </section>

  <!-- BANDA -->
  <div class="bg-banda">
    <Trama />
    <div class="banda">
      <span>{data.banda.izquierda}</span>
      <Cruz style="margin-top:-3px" />
      <span class="arcilla">{data.banda.derecha}</span>
    </div>
    <Trama />
  </div>

  <!-- SERVICIOS -->
  <section class="section servicios">
    <div class="grid-auto intro" style="--min:340px" data-reveal="up">
      <h2 class="h2">{data.resumenServicios.titulo}</h2>
      <p class="muted">{data.resumenServicios.texto}</p>
    </div>
    <div class="servicios-wrap">
      <svg data-reveal="sew" class="costura" viewBox="0 0 1296 60" preserveAspectRatio="none" aria-hidden="true">
        <path d="M70 40 C 260 -10, 380 70, 650 30 C 900 -6, 1040 60, 1226 30" style="fill:none;stroke:var(--marron);stroke-width:1.6;stroke-dasharray:12 9;stroke-linecap:round" />
        <path d="M62 32 L78 48 M78 32 L62 48 M642 22 L658 38 M658 22 L642 38 M1218 22 L1234 38 M1234 22 L1218 38" style="fill:none;stroke:var(--arcilla);stroke-width:2.4;stroke-linecap:round" />
      </svg>
      <div class="grid-auto tarjetas">
        {data.resumenServicios.items.map((s, i) => (
          <a href={`/servicios#s${i + 1}`} class="tarjeta" data-reveal="up" data-delay={i * 120 || undefined}>
            <Trama width={420} height={12} />
            <div class="tarjeta-cuerpo">
              <div class="tarjeta-top"><span class="etiqueta">{s.etiqueta}</span><span class="numeral">{dos(i)}</span></div>
              <svg viewBox="0 0 300 16" preserveAspectRatio="none" class="regla" aria-hidden="true">
                <path d="M2 8 C 80 6, 200 10, 298 8" style="fill:none;stroke:var(--placeholder);stroke-width:6;stroke-linecap:round;filter:url(#pz)" />
                <path d="M2 2 L2 14 M150 2 L150 14 M298 2 L298 14" style="fill:none;stroke:var(--marron);stroke-width:1.4;stroke-linecap:round" />
              </svg>
              <h3 class="h3 tarjeta-h3">{s.titulo}</h3>
              <p>{s.texto}</p>
              <span class="link-arrow">Ver servicio →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
    <a href="/contacto#agenda" class="btn btn-primary centro">{site.botonAgenda}</a>
  </section>

  <Hilvan mb={64} />

  <!-- CÓMO TRABAJAMOS -->
  <section class="section bg-banda como">
    <div class="como-head" data-reveal="up">
      <div class="eyebrow">{pasos.eyebrow}</div>
      <h2 class="h2-sm" style="max-width:22ch">{pasos.titulo}</h2>
    </div>
    <Pasos />
    <p class="muted nota" data-reveal="up">{pasos.nota}</p>
    <a href="/contacto#agenda" class="btn btn-primary">{site.botonAgenda}</a>
  </section>

  <!-- QUÉ ES LOOM -->
  <section class="section grid-auto que-es" style="--min:340px">
    <Marco imagen={data.queEs.imagen} alt="Detalle de tejido" etiqueta={data.queEs.imagenEtiqueta} ratio="1/1" inset={14} reveal="up" />
    <div class="que-es-texto" data-reveal="up" data-delay="120">
      <h2 class="eyebrow" style="margin:0;font-size:15px;padding-top:3px">{data.queEs.eyebrow}</h2>
      <p class="frase">{data.queEs.frase}</p>
      <p class="cuerpo">{data.queEs.texto}</p>
    </div>
  </section>

  <Hilvan flip />

  <!-- DIFERENCIALES -->
  <section class="section diferenciales">
    <h2 class="h2-sm" style="max-width:22ch" data-reveal="up">{data.diferenciales.titulo}</h2>
    <div class="grid-auto dif-grid">
      {data.diferenciales.items.map((d, i) => (
        <div class="dif" data-reveal="up" data-delay={(i % 3) * 100 || undefined}>
          <div class="dif-num"><Cruz /><span>{dos(i)}</span></div>
          <h3 class="h3">{d.titulo}</h3>
          <p>{d.texto}</p>
        </div>
      ))}
    </div>
  </section>

  <Hilvan mb={64} />

  <!-- CASO DE ÉXITO -->
  <section class="caso bg-banda grid-auto" style="--min:380px">
    <div class="caso-texto" data-reveal="up">
      <div class="badge">{data.caso.etiqueta}</div>
      <h2 class="h2-sm" style="font-size:clamp(28px,3vw,36px)">{data.caso.titulo}</h2>
      <div class="caso-bloque"><h3>El desafío</h3><p>{data.caso.desafio}</p></div>
      <div class="caso-bloque"><h3>Lo que hicimos</h3><p>{data.caso.hicimos}</p></div>
      <a href="/contacto#agenda" class="btn btn-primary" style="align-self:flex-start;margin-top:8px">{site.botonAgenda}</a>
    </div>
    <Marco imagen={data.caso.imagen} alt={data.caso.titulo} etiqueta={data.caso.imagenEtiqueta} minHeight={440} />
  </section>

  <Hilvan flip mt={64} />

  <!-- FUNDADORAS -->
  <section class="section founders">
    <div class="founders-head" data-reveal="up">
      <div class="eyebrow">{equipo.eyebrow}</div>
      <h2 class="h2-sm" style="font-size:clamp(28px,3vw,36px);max-width:20ch">{equipo.titulo}</h2>
    </div>
    <div class="grid-auto personas">
      <svg data-reveal="sew" class="lazo" viewBox="0 0 400 80" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 40 C 80 10, 140 70, 200 40 C 260 10, 320 70, 400 40" style="fill:none;stroke:var(--arcilla);stroke-width:1.8;stroke-linecap:round;filter:url(#pz)" />
      </svg>
      {equipo.personas.map((p, i) => (
        <div class="persona" data-reveal="up" data-delay={i * 120 || undefined}>
          <Marco imagen={p.foto} alt={p.nombre} etiqueta={p.fotoEtiqueta} ratio="4/5" inset={10} class="foto" />
          <h3 class="h3" style="font-size:18px;margin-top:8px">{p.nombre}</h3>
          <div class="rol">{p.rol}</div>
          <p>{p.bio}</p>
        </div>
      ))}
    </div>
    <a href="/nosotras" class="link-arrow">Nosotras →</a>
  </section>

  <Hilvan mb={48} />

  <!-- FAQ -->
  <section class="faq-sec">
    <h2 class="h2-sm" style="font-size:clamp(28px,3vw,36px);text-align:center" data-reveal="up">{faq.titulo}</h2>
    <Faq soloInicio />
  </section>

  <CtaFinal />
</Base>

<style>
  /* Hero */
  .hero {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: 56px;
    padding-top: 69px;
    align-items: center;
  }
  .hero-texto { display: flex; flex-direction: column; gap: 30px; min-width: 0; }
  .hero-eyebrow { display: flex; align-items: center; gap: 12px; letter-spacing: .28em; }
  .hero-eyebrow span { padding-top: 3px; }
  @media (max-width: 760px) { .hero-eyebrow { align-items: flex-start; } .hero-eyebrow :global(svg) { margin-top: 4px; } }
  .hero-p { margin: 0; font-size: 20px; line-height: 1.55; max-width: 34ch; text-wrap: pretty; }
  .botones { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin-top: 6px; }
  .tagline { margin-top: 18px; }

  /* Banda */
  .banda {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 40px;
    padding: 20px var(--gutter) 17px;
    font-family: var(--josefin);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: .24em;
    text-transform: uppercase;
    text-align: center;
  }
  .arcilla { color: var(--arcilla); }

  /* Servicios */
  .servicios { display: flex; flex-direction: column; gap: 56px; }
  .intro { gap: 24px 56px; align-items: end; }
  .intro p { margin: 0; font-size: 18px; line-height: 1.65; }
  .servicios-wrap { position: relative; }
  .costura { position: absolute; left: 0; right: 0; top: -6px; width: 100%; height: 60px; overflow: visible; pointer-events: none; }
  .tarjetas { gap: 28px; padding-top: 56px; }
  .tarjeta { text-decoration: none; color: var(--marron); background: var(--banda); display: flex; flex-direction: column; transition: background-color .3s; }
  .tarjeta:hover { color: var(--marron); background: #ECE2D1; }
  .tarjeta-cuerpo { padding: 36px 32px; display: flex; flex-direction: column; gap: 16px; flex: 1; }
  .tarjeta-top { display: flex; justify-content: space-between; align-items: baseline; }
  .etiqueta { font-size: 15px; font-weight: 600; color: var(--arcilla); }
  .regla { width: 100%; height: 12px; overflow: visible; }
  .tarjeta-h3 { font-size: 18px; line-height: 1.3; letter-spacing: .1em; }
  .tarjeta p { margin: 0; font-size: 16px; line-height: 1.65; flex: 1; }
  .centro { align-self: center; }

  /* Cómo trabajamos */
  .como { padding-bottom: 94px; display: flex; flex-direction: column; align-items: center; gap: 56px; }
  .como-head { display: flex; flex-direction: column; align-items: center; gap: 16px; text-align: center; }
  .nota { margin: 0; font-size: 17px; text-align: center; }

  /* Qué es LOOM */
  .que-es { gap: 56px; align-items: center; }
  .que-es-texto { display: flex; flex-direction: column; gap: 28px; }
  .frase { margin: 0; font-family: var(--josefin); font-weight: 300; font-size: clamp(24px, 2.4vw, 30px); line-height: 1.3; text-wrap: pretty; }
  .cuerpo { margin: 0; font-size: 17px; line-height: 1.7; max-width: 50ch; text-wrap: pretty; }

  /* Diferenciales */
  .diferenciales { display: flex; flex-direction: column; gap: 56px; }
  .dif-grid { gap: 48px 40px; }
  .dif { display: flex; flex-direction: column; gap: 12px; border-top: var(--punteado); padding-top: 22px; }
  .dif-num { display: flex; align-items: center; gap: 10px; }
  .dif-num span { font-family: var(--josefin); font-size: 15px; color: var(--arcilla); padding-top: 3px; }
  .dif p { margin: 0; font-size: 16px; line-height: 1.6; }

  /* Caso de éxito */
  .caso { margin: 0 var(--gutter); }
  .caso-texto { padding: 72px 64px; display: flex; flex-direction: column; gap: 28px; }
  .badge {
    align-self: flex-start;
    font-family: var(--josefin);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: .28em;
    text-transform: uppercase;
    padding: 9px 14px 6px;
    border: 1.5px dashed var(--arcilla);
    color: var(--arcilla);
  }
  .caso-bloque { display: flex; flex-direction: column; gap: 6px; }
  .caso-bloque h3 { margin: 0; font-family: var(--josefin); font-weight: 600; font-size: 13px; letter-spacing: .24em; text-transform: uppercase; color: var(--arcilla); }
  .caso-bloque p { margin: 0; font-size: 17px; line-height: 1.65; }

  /* Fundadoras */
  .founders { padding-top: 94px; padding-bottom: 79px; display: flex; flex-direction: column; align-items: center; gap: 48px; text-align: center; }
  .founders-head { display: flex; flex-direction: column; align-items: center; gap: 18px; }
  .personas { --min: 280px; position: relative; gap: 56px 120px; width: 100%; max-width: 1040px; }
  .lazo { position: absolute; left: calc(50% - 200px); top: 150px; width: 400px; height: 80px; overflow: visible; pointer-events: none; }
  .persona { display: flex; flex-direction: column; align-items: center; gap: 16px; }
  .persona :global(.foto) { width: 220px; }
  .persona :global(.foto .frame-inner) { outline: none; padding: 14px; }
  .rol { font-size: 15px; font-weight: 600; color: var(--arcilla); }
  .persona p { margin: 0; font-size: 16px; line-height: 1.6; max-width: 36ch; }

  /* FAQ */
  .faq-sec { padding: 29px var(--gutter) 86px; display: flex; flex-direction: column; gap: 40px; max-width: 1000px; margin: 0 auto; }

  @media (max-width: 760px) {
    .section { padding-top: 64px; padding-bottom: 64px; }
    .botones .btn { width: 100%; }
    .caso-texto { padding: 48px 28px; }
    .lazo { display: none; }
  }
</style>
