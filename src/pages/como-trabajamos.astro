---
import Base from '../layouts/Base.astro';
import Pasos from '../components/Pasos.astro';
import CtaFinal from '../components/CtaFinal.astro';

import site from '../data/site.json';
import data from '../data/como-trabajamos.json';
import pasos from '../data/pasos.json';
import servicios from '../data/servicios.json';

const dos = (n: number) => String(n + 1).padStart(2, '0');
---
<Base titulo={data.seo.titulo} descripcion={data.seo.descripcion}>

  <!-- INTRO -->
  <section class="intro">
    <div class="eyebrow eyebrow-sm">{pasos.eyebrow}</div>
    <h1 class="h1" style="max-width:18ch">{pasos.titulo}</h1>
    <p class="intro-p">{data.intro.texto}</p>
  </section>

  <!-- LOS 6 PASOS -->
  <section class="bg-banda pasos-sec">
    <Pasos />
    <p class="muted nota" data-reveal="up">{pasos.nota}</p>
    <a href="/contacto#agenda" class="btn btn-primary">{site.botonAgenda}</a>
  </section>

  <!-- PUNTO DE PARTIDA -->
  <section class="partida grid-auto">
    <div class="partida-texto" data-reveal="up">
      <h2 class="h2" style="font-size:clamp(30px,3.2vw,40px);line-height:1.1">{data.puntoPartida.titulo}</h2>
      <p>{data.puntoPartida.texto}</p>
    </div>
    <div class="atajos" data-reveal="up" data-delay="120">
      {servicios.servicios.map((s, i) => (
        <a href={`/servicios#s${i + 1}`} class="atajo"><span>{dos(i)}</span>{s.etiqueta}</a>
      ))}
    </div>
  </section>

  <CtaFinal />
</Base>

<style>
  .intro { padding: 88px var(--gutter) 72px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 22px; }
  .intro-p { margin: 0; font-size: 20px; line-height: 1.55; max-width: 44ch; }
  .pasos-sec { padding: 72px var(--gutter) 96px; display: flex; flex-direction: column; align-items: center; gap: 56px; }
  .nota { margin: 0; font-size: 17px; text-align: center; }
  .partida { --min: 300px; padding: 88px var(--gutter); gap: 24px 72px; align-items: center; }
  .partida-texto { display: flex; flex-direction: column; gap: 14px; }
  .partida-texto p { margin: 0; font-size: 17px; line-height: 1.7; text-wrap: pretty; }

  @media (max-width: 760px) {
    .intro { padding-top: 56px; padding-bottom: 48px; }
    .pasos-sec { padding-top: 56px; padding-bottom: 64px; }
    .partida { padding-top: 64px; padding-bottom: 64px; }
    .pasos-sec .btn { width: 100%; }
  }
</style>
