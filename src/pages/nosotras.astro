---
import Base from '../layouts/Base.astro';
import Cruz from '../components/Cruz.astro';
import Trama from '../components/Trama.astro';
import Marco from '../components/Marco.astro';
import Hilvan from '../components/Hilvan.astro';
import CtaFinal from '../components/CtaFinal.astro';

import data from '../data/nosotras.json';
import equipo from '../data/equipo.json';
---
<Base titulo={data.seo.titulo} descripcion={data.seo.descripcion}>

  <!-- INTRO -->
  <section class="intro">
    <div class="eyebrow eyebrow-sm">{equipo.eyebrow}</div>
    <h1 class="h1" style="max-width:20ch">{data.intro.titulo}</h1>
    <p class="intro-p">{equipo.titulo}</p>
  </section>

  <!-- PERFILES (la foto alterna de lado) -->
  {equipo.personas.map((p, i) => (
    <>
      <Hilvan flip={i % 2 === 1} />
      <section class:list={['perfil', i % 2 === 1 && 'invertido']}>
        <Marco imagen={p.foto} alt={p.nombre} etiqueta={p.fotoEtiqueta} ratio="4/5" inset={14} reveal="up" class="perfil-foto" />
        <div class="perfil-texto" data-reveal="up" data-delay="120">
          <div class="eyebrow eyebrow-sm">{p.area}</div>
          <h2 class="h2" style="font-size:clamp(30px,3.2vw,40px);line-height:1.1">{p.nombre}</h2>
          <div class="rol"><Cruz />{p.rol}</div>
          <p class="bio">{p.bio}</p>
          <a href={`mailto:${p.email}`} class="mail">{p.email}</a>
        </div>
      </section>
    </>
  ))}

  <!-- PRESENCIA -->
  <section class="bg-banda">
    <Trama />
    <div class="presencia">
      <h2 class="h2" style="font-size:clamp(30px,3.2vw,40px);line-height:1.1" data-reveal="up">{data.presencia.titulo}</h2>
      <div class="ciudades">
        <div class="ciudad" data-reveal="up">
          <h3>{data.presencia.izquierda.ciudad}</h3>
          <span>{data.presencia.izquierda.persona}</span>
        </div>
        <svg data-reveal="sew" class="hilo" viewBox="0 0 320 60" preserveAspectRatio="none" aria-hidden="true">
          <path d="M0 30 C 60 4, 110 56, 160 30 C 210 4, 260 56, 320 30" style="fill:none;stroke:var(--arcilla);stroke-width:2.4;stroke-linecap:round;vector-effect:non-scaling-stroke;filter:url(#pz)" />
        </svg>
        <div class="ciudad" data-reveal="up" data-delay="200">
          <h3>{data.presencia.derecha.ciudad}</h3>
          <span>{data.presencia.derecha.persona}</span>
        </div>
      </div>
    </div>
    <Trama />
  </section>

  <div style="height:88px"></div>
  <CtaFinal />
</Base>

<style>
  .intro { padding: 88px var(--gutter) 64px; display: flex; flex-direction: column; gap: 24px; }
  .intro-p { margin: 0; font-size: 20px; line-height: 1.55; max-width: 46ch; text-wrap: pretty; }

  .perfil {
    padding: 80px var(--gutter);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr));
    gap: 48px 88px;
    align-items: center;
  }
  .perfil :global(.perfil-foto) { max-width: 440px; width: 100%; }
  .perfil :global(.perfil-foto .frame-inner) { outline-offset: -10px; padding: 20px; }
  /* En el segundo perfil la foto va a la derecha (solo cuando hay 2 columnas) */
  @media (min-width: 900px) {
    .invertido :global(.perfil-foto) { order: 2; justify-self: end; }
  }
  .perfil-texto { display: flex; flex-direction: column; gap: 18px; min-width: 0; }
  .rol { display: flex; align-items: center; gap: 10px; font-size: 16px; font-weight: 600; }
  .bio { margin: 0; font-size: 19px; line-height: 1.7; max-width: 44ch; text-wrap: pretty; }
  .mail { font-size: 16px; color: var(--tinta); }
  .mail:hover { color: var(--arcilla); }

  .presencia { padding: 80px var(--gutter); display: flex; flex-direction: column; align-items: center; text-align: center; gap: 40px; }
  .ciudades { display: grid; grid-template-columns: 1fr minmax(80px, 320px) 1fr; align-items: center; gap: 24px; width: 100%; max-width: 900px; }
  .ciudad { display: flex; flex-direction: column; gap: 6px; align-items: center; }
  .ciudad h3 { margin: 0; font-family: var(--josefin); font-weight: 600; font-size: 18px; letter-spacing: .16em; text-transform: uppercase; padding-top: 3px; }
  .ciudad span { font-size: 15px; color: var(--marron-2); }
  .hilo { width: 100%; height: 48px; overflow: visible; }

  @media (max-width: 760px) {
    .intro { padding-top: 56px; padding-bottom: 48px; }
    .perfil { padding-top: 56px; padding-bottom: 56px; }
    .perfil :global(.perfil-foto) { max-width: none; }
    .presencia { padding-top: 64px; padding-bottom: 64px; }
    .ciudades { grid-template-columns: 1fr; gap: 16px; }
    .hilo { width: 160px; justify-self: center; }
  }
</style>
