---
import Base from '../layouts/Base.astro';
import Cruz from '../components/Cruz.astro';
import Trama from '../components/Trama.astro';
import Marco from '../components/Marco.astro';
import Hilvan from '../components/Hilvan.astro';
import CtaFinal from '../components/CtaFinal.astro';

import site from '../data/site.json';
import data from '../data/servicios.json';

const dos = (n: number) => String(n + 1).padStart(2, '0');
---
<Base titulo={data.seo.titulo} descripcion={data.seo.descripcion}>

  <!-- INTRO -->
  <section class="intro">
    <div class="eyebrow eyebrow-sm">{data.intro.eyebrow}</div>
    <h1 class="h1" style="max-width:20ch">{data.intro.titulo}</h1>
    <p class="intro-p">{data.intro.texto}</p>
    <div class="atajos">
      {data.servicios.map((s, i) => (
        <a href={`#s${i + 1}`} class="atajo"><span>{dos(i)}</span>{s.etiqueta}</a>
      ))}
    </div>
  </section>

  <Hilvan />

  <!-- LOS 3 SERVICIOS -->
  {data.servicios.map((s, i) => (
    <section id={`s${i + 1}`} class:list={['servicio', i % 2 === 1 && 'par']}>
      <div class="servicio-texto" data-reveal="up">
        <div class="servicio-num"><span class="num-grande">{dos(i)}</span><span class="etiqueta">{s.etiqueta}</span></div>
        <h2 class="h2">{s.titulo}</h2>
        <p class="lead">{s.texto}</p>
        {s.textoExtra && <p class="cuerpo">{s.textoExtra}</p>}

        <div class="detalle grid-auto">
          <div class="col">
            <h3 class="mini">Para quién es</h3>
            <p class="chico">{s.paraQuien}</p>
          </div>
          <div class="col">
            <h3 class="mini">Qué incluye</h3>
            <ul>
              {s.incluye.map((item) => (
                <li><Cruz size={11} style="transform:translateY(1px)" /><span>{item}</span></li>
              ))}
            </ul>
          </div>
        </div>

        {s.etapas.length > 0 && (
          <details class="etapas">
            <summary><Cruz class="cruz" />Ver las {s.etapas.length} etapas</summary>
            <div class="etapas-lista">
              {s.etapas.map((e) => (
                <div class="etapa">
                  <h3 class="mini" style="color:var(--marron)">{e.titulo}</h3>
                  <p>{e.texto}</p>
                  {e.nota && <p class="muted">{e.nota}</p>}
                </div>
              ))}
            </div>
          </details>
        )}

        <div style="margin-top:8px"><a href="/contacto#agenda" class="btn btn-primary btn-sm">{site.botonAgenda}</a></div>
      </div>
      <Marco imagen={s.imagen} alt={s.titulo} etiqueta={s.imagenEtiqueta} ratio="4/5" inset={14} reveal="up" class="servicio-foto" />
    </section>
  ))}

  <!-- SERVICIO ADICIONAL -->
  <section class="bg-banda">
    <Trama />
    <div class="adicional grid-auto" data-reveal="up">
      <div class="titulo-bloque">
        <div class="eyebrow eyebrow-sm">{data.adicional.eyebrow}</div>
        <h2 class="h2">{data.adicional.titulo}</h2>
      </div>
      <p class="lead">{data.adicional.texto}</p>
    </div>
    <Trama />
  </section>

  <!-- HONORARIOS -->
  <section class="honorarios grid-auto">
    <div class="titulo-bloque" data-reveal="up">
      <div class="eyebrow eyebrow-sm">{data.honorarios.eyebrow}</div>
      <h2 class="h2">{data.honorarios.titulo}</h2>
    </div>
    <div class="honorarios-texto" data-reveal="up" data-delay="120">
      <p class="lead">{data.honorarios.texto}</p>
      {data.honorarios.textoExtra && <p class="cuerpo">{data.honorarios.textoExtra}</p>}
      <div style="margin-top:10px"><a href="/contacto#agenda" class="btn btn-primary btn-sm">{site.botonAgenda}</a></div>
    </div>
  </section>

  <CtaFinal />
</Base>

<style>
  /* Intro */
  .intro { padding: 88px var(--gutter) 72px; display: flex; flex-direction: column; gap: 24px; }
  .intro-p { margin: 0; font-size: 20px; line-height: 1.55; max-width: 52ch; text-wrap: pretty; }
  .atajos { margin-top: 8px; }

  /* Cada servicio */
  .servicio {
    scroll-margin-top: 90px;
    padding: 96px var(--gutter);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: 56px 80px;
    align-items: start;
  }
  .servicio.par { background: var(--banda); }
  .servicio-texto { display: flex; flex-direction: column; gap: 22px; min-width: 0; }
  .servicio-num { display: flex; align-items: baseline; gap: 18px; }
  .num-grande { font-family: var(--josefin); font-weight: 300; font-size: 64px; line-height: 1; color: var(--arcilla); }
  .etiqueta { font-size: 15px; font-weight: 600; color: var(--arcilla); }
  .h2 { font-size: clamp(30px, 3.2vw, 40px); line-height: 1.1; }
  .lead { margin: 0; font-size: 19px; line-height: 1.7; text-wrap: pretty; }
  .cuerpo { margin: 0; font-size: 17px; line-height: 1.7; text-wrap: pretty; }
  .chico { margin: 0; font-size: 16px; line-height: 1.7; }

  .servicio :global(.servicio-foto) { max-width: 460px; width: 100%; justify-self: end; }
  .servicio :global(.servicio-foto .frame-inner) { outline-offset: -10px; padding: 20px; }
  /* En los servicios pares la foto va a la izquierda (solo cuando hay 2 columnas) */
  @media (min-width: 900px) {
    .servicio.par :global(.servicio-foto) { order: -1; justify-self: start; }
  }

  .detalle { --min: 240px; gap: 28px; border-top: var(--punteado); padding-top: 24px; margin-top: 6px; }
  .col { display: flex; flex-direction: column; gap: 10px; }
  .mini { margin: 0; font-family: var(--josefin); font-weight: 600; font-size: 13px; letter-spacing: .16em; text-transform: uppercase; padding-top: 3px; color: var(--arcilla); }
  ul { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 8px; }
  li { display: flex; gap: 12px; align-items: baseline; font-size: 16px; line-height: 1.55; }

  /* Desplegable "Ver las 3 etapas" */
  .etapas { border: 1.5px dashed rgba(59, 42, 32, .4); padding: 18px 22px; background: var(--crudo); }
  .etapas summary { display: flex; align-items: center; gap: 12px; font-family: var(--josefin); font-weight: 600; font-size: 13px; letter-spacing: .2em; text-transform: uppercase; padding-top: 3px; }
  .etapas summary :global(.cruz) { transition: transform .35s var(--ease); }
  .etapas[open] summary :global(.cruz) { transform: rotate(45deg); }
  .etapas-lista { display: flex; flex-direction: column; gap: 18px; margin-top: 18px; }
  .etapa { display: flex; flex-direction: column; gap: 6px; }
  .etapa p { margin: 0; font-size: 15px; line-height: 1.7; text-wrap: pretty; }

  .btn-sm { min-height: 56px; padding: 3px 30px 0; font-size: 13px; }

  /* Adicional y honorarios */
  .adicional { --min: 340px; padding: 72px var(--gutter); gap: 24px 72px; align-items: start; }
  .titulo-bloque { display: flex; flex-direction: column; gap: 16px; }
  .honorarios { --min: 340px; padding: 96px var(--gutter) 88px; gap: 40px 80px; align-items: start; }
  .honorarios-texto { display: flex; flex-direction: column; gap: 18px; }

  @media (max-width: 760px) {
    .intro { padding-top: 56px; padding-bottom: 48px; }
    .servicio { padding-top: 64px; padding-bottom: 64px; }
    .servicio :global(.servicio-foto) { justify-self: stretch; max-width: none; }
    .honorarios { padding-top: 64px; padding-bottom: 64px; }
    .btn-sm { width: 100%; }
  }
</style>
