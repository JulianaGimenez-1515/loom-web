---
// Bloque azul "Let's build something together." al final de cada página
import site from '../data/site.json';
import Cruz from './Cruz.astro';
---
<section class="cta-wrap">
  <div class="cta" data-reveal="up">
    <Cruz size={18} color="var(--rosa)" class="esq tl" />
    <Cruz size={18} color="var(--rosa)" class="esq tr" />
    <Cruz size={18} color="var(--rosa)" class="esq bl" />
    <Cruz size={18} color="var(--rosa)" class="esq br" />
    <h2>{site.ctaFinal.titulo}</h2>
    <p>{site.ctaFinal.texto}</p>
    <div class="botones">
      <a href="/contacto#agenda" class="btn btn-light">{site.botonAgenda}</a>
      <a href={`https://wa.me/${site.whatsapp}`} class="btn btn-outline-light" target="_blank" rel="noopener">{site.botonWhatsapp}</a>
    </div>
    <div class="tag">{site.tagline}</div>
  </div>
</section>

<style>
  .cta-wrap { padding: 0 var(--gutter) 110px; }
  .cta {
    position: relative;
    padding: 80px 56px;
    background: var(--tinta);
    color: var(--crudo);
    outline: 1.5px dashed rgba(245, 239, 228, .45);
    outline-offset: -20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 28px;
  }
  .cta :global(.esq) { position: absolute; }
  .cta :global(.tl) { left: 11px; top: 11px; }
  .cta :global(.tr) { right: 11px; top: 11px; }
  .cta :global(.bl) { left: 11px; bottom: 11px; }
  .cta :global(.br) { right: 11px; bottom: 11px; }
  h2 {
    margin: 0;
    font-family: var(--josefin);
    font-weight: 300;
    font-size: clamp(34px, 4vw, 53px);
    line-height: 1.05;
    letter-spacing: .04em;
    text-transform: uppercase;
    max-width: 16ch;
    padding-top: .1em;
  }
  p { margin: 0; font-size: 18px; line-height: 1.6; max-width: 40ch; color: var(--hueso); }
  .botones { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; margin-top: 8px; }
  .tag { font-family: var(--josefin); font-weight: 600; font-size: 13px; letter-spacing: .3em; text-transform: uppercase; color: var(--rosa); margin-top: 16px; }
  @media (max-width: 760px) {
    .cta { padding: 64px 28px; }
    .botones .btn { width: 100%; }
  }
</style>
