---
// Los 6 pasos con la línea de tiza vertical que crece con el scroll
import data from '../data/pasos.json';
import Cruz from './Cruz.astro';
interface Props { fondo?: string }
const { fondo = 'var(--banda)' } = Astro.props;
const dos = (n: number) => String(n + 1).padStart(2, '0');
---
<div class="pasos" style={`--fondo:${fondo}`}>
  <div class="riel" data-draw="scroll" aria-hidden="true">
    <svg viewBox="0 0 30 1000" preserveAspectRatio="none">
      <path d="M15 0 C 9 160, 21 330, 15 500 S 10 840, 15 1000" style="fill:none;stroke:var(--tiza);stroke-width:14;stroke-linecap:round;vector-effect:non-scaling-stroke;opacity:.9" />
      <path d="M15 0 C 9 160, 21 330, 15 500 S 10 840, 15 1000" style="fill:none;stroke:var(--marron);stroke-width:1.8;stroke-dasharray:12 9;stroke-linecap:round;vector-effect:non-scaling-stroke" />
    </svg>
  </div>
  <ol>
    {data.pasos.map((p, i) => (
      <li class:list={['paso', i % 2 === 0 ? 'izq' : 'der']}>
        <div class="texto" data-reveal="up">
          <span class="numeral">{dos(i)}</span>
          <h3 class="h3">{p.titulo}</h3>
          <p>{p.texto}</p>
        </div>
        <div class="nudo"><div class="punto" data-reveal="pop"><Cruz size={18} stroke={2.6} /></div></div>
      </li>
    ))}
  </ol>
</div>

<style>
  .pasos { position: relative; width: 100%; max-width: 1100px; }
  ol { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 56px; }
  .riel { position: absolute; left: calc(50% - 15px); top: 20px; bottom: 20px; width: 30px; pointer-events: none; }
  .riel svg { width: 100%; height: 100%; overflow: visible; }

  .paso {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 96px minmax(0, 1fr);
    grid-template-areas: 'izq nudo der';
    align-items: start;
    position: relative;
    z-index: 1;
  }
  .nudo { grid-area: nudo; display: flex; justify-content: center; padding-top: 22px; }
  .punto { width: 40px; height: 40px; border-radius: 50%; background: var(--fondo); display: flex; align-items: center; justify-content: center; }
  .texto { display: flex; flex-direction: column; gap: 10px; max-width: 420px; }
  .izq .texto { grid-area: izq; align-items: flex-end; text-align: right; margin-left: auto; }
  .der .texto { grid-area: der; align-items: flex-start; text-align: left; }
  .numeral { color: var(--arcilla); }
  p { margin: 0; font-size: 17px; line-height: 1.6; }

  /* Mobile: la línea pasa a la izquierda y todos los textos a la derecha */
  @media (max-width: 760px) {
    .riel { left: 5px; }
    .paso { grid-template-columns: 40px minmax(0, 1fr); grid-template-areas: 'nudo texto'; column-gap: 20px; }
    .nudo { padding-top: 0; }
    .izq .texto, .der .texto { grid-area: texto; align-items: flex-start; text-align: left; margin-left: 0; }
  }
</style>
